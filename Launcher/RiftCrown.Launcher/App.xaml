<Application x:Class="RiftCrown.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#E9E6DC"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#263A40"/><Setter Property="Foreground" Value="#E9E6DC"/><Setter Property="BorderBrush" Value="#526063"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E5C789"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#12252B"/><Setter Property="Foreground" Value="#E9E6DC"/><Setter Property="CaretBrush" Value="#E9E6DC"/><Setter Property="BorderBrush" Value="#526063"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9E6DC"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,10"/></Style>
  </Application.Resources>
</Application>
