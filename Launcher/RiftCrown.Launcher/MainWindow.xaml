<Window x:Class="RiftCrown.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rift Crown Arena" Width="1020" Height="720" MinWidth="900" MinHeight="630" Background="#101D22" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid Margin="36,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Viewbox Width="68" Height="68" Margin="0,0,20,0"><Canvas Width="64" Height="64"><Path Data="M4,19 L16,29 L20,9 L32,23 L44,9 L48,29 L60,19 L52,45 L12,45 Z M14,51 L50,51 L48,57 L16,57 Z" Fill="#C8AD73"/><Path Data="M27,31 L32,25 L37,31 L32,42 Z" Fill="#5FB5CA"/></Canvas></Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="RIFT CROWN" FontFamily="Georgia" FontSize="32" FontWeight="Bold"/><TextBlock Text="A R E N A" FontSize="17" Foreground="#C8AD73" Margin="1,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="InstalledVersion" Text="Checking installation" FontSize="13" HorizontalAlignment="Right"/><TextBlock Text="Launcher 1.0.0 · Windows x64" FontSize="12" Foreground="#97A7AD" Margin="0,6,0,0"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#172A30" BorderBrush="#526063" BorderThickness="1">
        <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PATCH NOTES" FontSize="12" FontWeight="SemiBold" Foreground="#C8AD73"/><TextBlock x:Name="NotesVersion" Grid.Column="1" Text="Installed release" Foreground="#97A7AD" FontSize="12"/></Grid>
          <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PatchNotes" FontSize="15" LineHeight="24" TextWrapping="Wrap" Text="Your game files are checked before launch. Check for updates to read the newest release notes."/></ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,24,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" FontSize="14" Text="Ready" TextWrapping="Wrap"/><Button x:Name="CancelButton" Grid.Column="1" Content="CANCEL" Padding="12,4" Visibility="Collapsed" Click="Cancel_Click"/></Grid>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100" Foreground="#63B2C4" Background="#263A40" BorderThickness="0"/>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="PlayButton" Content="PLAY" FontSize="21" FontWeight="Bold" Background="#C8AD73" Foreground="#142328" BorderBrush="#C8AD73" Click="Play_Click"/>
          <UniformGrid Grid.Column="2" Columns="3"><Button x:Name="CheckButton" Content="CHECK FOR UPDATES" Margin="0,0,8,0" Click="Check_Click"/><Button x:Name="UpdateButton" Content="UPDATE" Margin="0,0,8,0" Click="Update_Click"/><Button x:Name="RepairButton" Content="REPAIR FILES" Click="Repair_Click"/></UniformGrid>
        </Grid>
      </Grid>
      <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Your profile, decks and replays stay on this PC." Foreground="#97A7AD" FontSize="12" VerticalAlignment="Center"/><Button x:Name="SettingsButton" Grid.Column="1" Content="SETTINGS" Padding="12,8" Margin="10,0,0,0" Click="Settings_Click"/><Button x:Name="SaveFolderButton" Grid.Column="2" Content="OPEN SAVE FOLDER" Padding="12,8" Margin="10,0,0,0" Click="Saves_Click"/><Button x:Name="LogsButton" Grid.Column="3" Content="OPEN LOGS" Padding="12,8" Margin="10,0,0,0" Click="Logs_Click"/></Grid>
    </Grid>
    <Grid x:Name="SettingsOverlay" Background="#ED101D22" Visibility="Collapsed">
      <Border MaxWidth="680" Margin="30" Padding="28" Background="#172A30" BorderBrush="#687B7F" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel><TextBlock Text="LAUNCHER SETTINGS" FontSize="21" FontFamily="Georgia" Margin="0,0,0,22"/><TextBlock Text="Update manifest URL" Margin="0,0,0,6"/><TextBox x:Name="EndpointInput"/><TextBlock Text="Game installation folder" Margin="0,16,0,6"/><TextBox x:Name="InstallInput"/><TextBlock Text="Choose a separate game folder. Your save folder is preserved. A new empty location requires an update download." FontSize="12" Foreground="#97A7AD" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Game launch arguments" Margin="0,16,0,6"/><TextBox x:Name="ArgumentsInput"/><CheckBox x:Name="StartupCheck" Content="Check for updates when the launcher opens"/><TextBlock x:Name="SettingsError" Foreground="#E8AA91" TextWrapping="Wrap" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SettingsCancelButton" Content="CANCEL" Click="SettingsCancel_Click" Margin="0,0,12,0"/><Button x:Name="SettingsSaveButton" Content="SAVE SETTINGS" Background="#C8AD73" Foreground="#142328" Click="SettingsSave_Click"/></StackPanel></StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
